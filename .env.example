# Copy these into Hostinger (Node.js app > Environment variables) before building.
# NEXT_PUBLIC_ values are fixed at build time: redeploy after changing them.

# Neon > your project > Connect > Pooled connection. Server-only secret.
DATABASE_URL=postgresql://USER:PASSWORD@ep-xxxxxxxx-pooler.ap-southeast-1.aws.neon.tech/neondb?sslmode=require

# Your public site address, no trailing slash. Must be your real domain for Google
# sign-in and password-reset links (for example https://assetmeet.com).
NEXT_PUBLIC_SITE_URL=https://assetmeet.com

# Random secret for signing sessions, at least 32 characters.
# Generate one with: openssl rand -base64 32
BETTER_AUTH_SECRET=

# Optional: mailbox that sends password-reset emails (Hostinger email: smtp.hostinger.com,
# port 465). Without it, accounts still work; only "Forgot password" is unavailable.
SMTP_HOST=smtp.hostinger.com
SMTP_PORT=465
SMTP_USER=no-reply@assetmeet.com
SMTP_PASSWORD=
MAIL_FROM="AssetMeet <no-reply@assetmeet.com>"

# Optional: "Continue with Google". Google Cloud Console > APIs & Services > Credentials >
# OAuth client ID (Web application). Authorised redirect URI:
#   https://assetmeet.com/api/auth/callback/google
# Leave empty to hide the Google button.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
