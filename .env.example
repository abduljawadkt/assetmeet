# Copy these into Hostinger (Node.js app > Environment variables) before building.
# NEXT_PUBLIC_ values are baked in at build time: redeploy after changing them.

# Supabase > Project Settings > API (or the "Connect" button)
NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT-REF.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_xxxxxxxxxxxxxxxx

# Supabase > Connect > Transaction pooler (port 6543). Server-only secret: never share it.
DATABASE_URL=postgresql://postgres.YOUR-PROJECT-REF:YOUR-DB-PASSWORD@aws-0-ap-south-1.pooler.supabase.com:6543/postgres

# Your public site address, no trailing slash. Used for sign-in links and social previews.
NEXT_PUBLIC_SITE_URL=https://www.your-domain.com
